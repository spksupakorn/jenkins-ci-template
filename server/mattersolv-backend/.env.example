# คัดลอกเป็น .env บน server (chmod 660) ห้าม commit ไฟล์จริง
# ถ้าโฟลเดอร์นี้มี .env ใช้งานอยู่แล้ว ห้าม cp ทับ: สำรองด้วย `cp -p .env .env.orig` ก่อน
# และถ้า DB มีข้อมูลอยู่แล้ว ใช้รหัสผ่านที่ใช้อยู่จริง ห้ามสร้างใหม่ (สร้างใหม่ได้เฉพาะ DB ว่าง: openssl rand -hex 24)
# ไฟล์นี้ใช้แทนค่าตัวแปรใน docker-compose.yml เท่านั้น ไม่ถูกส่งเข้า container
# รหัสผ่านใส่เฉพาะ [A-Za-z0-9] (ถูกฝังใน URL)

# deploy.sh เขียนทับทุก deploy ก่อน deploy ครั้งแรกให้ใส่ tag ของ api ที่รันอยู่ตอนนี้
# (ดูจาก `docker compose ps`) ไม่งั้น rollback จะกลับไปที่ tag ที่ไม่มีอยู่จริง ถ้ายังไม่มีอะไรรันให้ใช้ค่าใด ๆ ที่ไม่ว่าง
IMAGE_TAG=unset-first-deploy

POSTGRES_BOOTSTRAP_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
PLATFORM_DB_PASSWORD=
# ไม่บังคับ: ใช้เฉพาะตอน init volume ว่าง (role dev_altpro) ปล่อยว่าง = ล็อกอินด้วยรหัสผ่านไม่ได้
DEV_DB_PASSWORD=

# path ที่ api ตอบ (สถานะ <400 ถือว่าผ่าน) สำหรับ healthcheck
API_HEALTH_PATH=/api/v1/health

# ไม่บังคับ
# PGBOUNCER_MAX_CLIENT_CONN=500
# PGBOUNCER_DEFAULT_POOL_SIZE=20
# PGBOUNCER_MAX_DB_CONNECTIONS=40
